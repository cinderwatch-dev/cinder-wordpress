{
    "name": "cinderwatch/cinder-wordpress",
    "description": "WordPress adapter for Cinder error, log, trace, health and schedule monitoring.",
    "keywords": [
        "cinder",
        "wordpress",
        "errors",
        "health",
        "monitoring",
        "cinderwatch"
    ],
    "homepage": "https://github.com/cinderwatch-dev/cinder-wordpress",
    "license": "MIT",
    "type": "wordpress-plugin",
    "authors": [
        {
            "name": "Rhys Lees",
            "email": "43909932+RhysLees@users.noreply.github.com",
            "homepage": "https://www.rhyslees.co.uk",
            "role": "Software Engineer"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer/installers": "^2.0",
        "nyholm/psr7": "^1.8",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0|^2.0",
        "cinderwatch/cinder-php": "^1.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "laravel/pint": "^1.24",
        "pestphp/pest": "^3.0|^4.0",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.0",
        "brianhenryie/strauss": "^0.25"
    },
    "autoload": {
        "psr-4": {
            "Cinderwatch\\WordPress\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Cinderwatch\\WordPress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=100",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
